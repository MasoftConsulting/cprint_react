# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel : clé "service_role". Sert uniquement à compter les comptes
# sur le tableau de bord admin. Ne JAMAIS la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Alertes e-mail des messages de contact (facultatif) ---
# N'importe quel fournisseur SMTP convient : Resend, Brevo, Gmail /
# Google Workspace, Office 365, ou le serveur de votre hébergeur.
# Sans ces variables, les messages sont enregistrés mais aucun e-mail
# n'est envoyé — le site continue de fonctionner normalement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché. Vide, on reprend SMTP_USER.
SMTP_FROM=

# Sert au lien « Voir dans l'administration » du mail d'alerte.
NEXT_PUBLIC_SITE_URL=https://cprint-react.vercel.app

# --- Service d'impression (API FastAPI) ---
# URL publique de l'API Python qui pilote la Sharp. Cette API tourne sur une
# machine du magasin — un hébergement cloud ne peut pas parler à une imprimante
# physique du réseau local — et est exposée par un tunnel Cloudflare
# (voir campus-print/deploy/cloudflared/README.md).
#
# Publique par nature : le navigateur du client l'appelle directement, aussi
# bien depuis la borne que depuis le téléphone qui scanne le QR code.
#
# En développement sur le même Wi-Fi : http://192.168.x.x:8000
# Vide : les pages /imprimer affichent « service indisponible » au lieu de planter.
NEXT_PUBLIC_PRINT_API_URL=https://api.mascprint.online
